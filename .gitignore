# Build artifacts inside vendored packages

# Vercel project link (local credentials/metadata)
.vercel/

# xcodebuild derived data for the iOS dev-run script
ios/build/
ios/build-sim/

android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties

# Per-project termio session state
/.termio/

# Python bytecode caches left by the repo's own scripts (download stats, icon
