{
  "sourceLanguage": "en",
  "strings": {
    "The token wasn’t rotated: %@": {
      "comment": "Settings ▸ Server ▸ Pairing, under Rotate Token; %@ is termiod's error message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌未轮换：%@"
          }
        }
      }
    },
    "Built-In Tailscale": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: the switch that puts this Mac on the tailnet as its own device.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 Tailscale"
          }
        }
      }
    },
    "This build of Termio doesn’t include built-in Tailscale.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本的 Termio 不含内置 Tailscale。"
          }
        }
      }
    },
    "Connect Over": {
      "comment": "Settings ▸ Server ▸ Network: the picker for how an iPhone reaches this Mac (Local Network, Tailscale, a tunnel).",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接方式"
          }
        }
      }
    },
    "Paired iPhones must scan the code again after Direct Attach is switched.": {
      "comment": "Settings ▸ Server ▸ Pairing footer: flipping the Direct Attach switch signs out every paired iPhone.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换直接连接后，已配对的 iPhone 需要重新扫码。"
          }
        }
      }
    },
    "Needs Direct Attach, under Pairing below.": {
      "comment": "Settings ▸ Server ▸ Network, built-in Tailscale: why the switch is disabled. Direct Attach is a switch in the Pairing section below.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要开启下方“配对”中的直接连接。"
          }
        }
      }
    },
    "This Mac joins your tailnet as a device of its own. It doesn’t need the Tailscale app.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 作为一台独立设备加入你的 tailnet，不需要 Tailscale 应用。"
          }
        }
      }
    },
    "Access": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: row label for who may connect.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问"
          }
        }
      }
    },
    "Nobody: a tagged device has no owner": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无人可访问：带标签的设备没有所有者"
          }
        }
      }
    },
    "Only %@": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale; %@ is a Tailscale login name.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 %@"
          }
        }
      }
    },
    "Only the account that signed in": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限登录的账号"
          }
        }
      }
    },
    "Sign Out…": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录…"
          }
        }
      }
    },
    "Sign this Mac out of Tailscale?": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: confirmation title.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让这台 Mac 退出 Tailscale 登录？"
          }
        }
      }
    },
    "Sign Out": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: destructive confirmation button.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录"
          }
        }
      }
    },
    "iPhones paired over the tailnet can’t connect until you sign in again.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你重新登录之前，通过 tailnet 配对的 iPhone 无法连接。"
          }
        }
      }
    },
    "Tailscale Account": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 账号"
          }
        }
      }
    },
    "Signs this Mac’s device out of your tailnet.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让这台 Mac 的设备退出你的 tailnet。"
          }
        }
      }
    },
    "Sign in with the Tailscale account your iPhone uses.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的 iPhone 所用的 Tailscale 账号登录。"
          }
        }
      }
    },
    "Approve…": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: opens the Tailscale admin console.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准…"
          }
        }
      }
    },
    "Approve this Mac in the Tailscale admin console.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tailscale 管理控制台中批准这台 Mac。"
          }
        }
      }
    },
    "Stopped": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: status when the node stopped with no message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        }
      }
    },
    "Works from any network while Tailscale is connected on your iPhone. Traffic stays on your tailnet.": {
      "comment": "Settings ▸ Server ▸ Pairing, built-in Tailscale: footer.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 iPhone 上的 Tailscale 已连接，在任何网络下都能用。流量只走你的 tailnet。"
          }
        }
      }
    },
    "Built-in Tailscale isn’t connected yet. Finish signing in under Settings ▸ Server ▸ Network.": {
      "comment": "Pair iPhone sheet, when built-in Tailscale is not connected.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 Tailscale 尚未连接。请在“设置 ▸ Termio server ▸ 网络”中完成登录。"
          }
        }
      }
    },
    "Allow Paired Devices": {
      "comment": "Master switch in Settings ▸ Server ▸ Pairing: whether paired iPhones may connect to this Mac.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许已配对设备"
          }
        }
      }
    },
    "Close Panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭面板"
          }
        }
      }
    },
    "Connected · %@": {
      "comment": "Tailscale status in Settings ▸ Server ▸ Pairing; %@ is this Mac's Tailscale IP address.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接 · %@"
          }
        }
      }
    },
    "Groups": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组"
          }
        }
      }
    },
    "Horizontal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横向"
          }
        }
      }
    },
    "Local Network": {
      "comment": "Picker entry in Settings ▸ Server ▸ Pairing: no tunnel, reach this Mac over the LAN.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网"
          }
        }
      }
    },
    "Machines signed in to Tailscale. Choose one to fill in its address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 Tailscale 的机器。选择一台即可填入它的地址。"
          }
        }
      }
    },
    "Network": {
      "comment": "Picker in Settings ▸ Server ▸ Pairing: which network the iPhone reaches this Mac over (local network, Tailscale, or a tunnel).",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络"
          }
        }
      }
    },
    "Not Connected": {
      "comment": "Tailscale status in Settings ▸ Server ▸ Pairing when this Mac is not on a running tailnet.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        }
      }
    },
    "Offline · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 · %@"
          }
        }
      }
    },
    "On Your Tailnet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 tailnet 上"
          }
        }
      }
    },
    "On iPhone, tap the Mac pill ▸ Scan QR Code.": {
      "comment": "“Mac pill” is a control in the iPhone app and ▸ separates steps in a menu path.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上轻点 Mac 胶囊按钮 ▸ 扫描二维码。"
          }
        }
      }
    },
    "Open Tailscale": {
      "comment": "Button that opens the Tailscale app when it is not connected.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Tailscale"
          }
        }
      }
    },
    "Open a panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开面板"
          }
        }
      }
    },
    "Pair iPhone": {
      "comment": "Row title in Settings ▸ Server ▸ Pairing, and the title of the QR code sheet.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对 iPhone"
          }
        }
      }
    },
    "Pair iPhone…": {
      "comment": "Menu bar menu item and command palette action that open the pairing QR code.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对 iPhone…"
          }
        }
      }
    },
    "Pairing": {
      "comment": "Section header in Settings ▸ Server: pairing an iPhone with this machine.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Show QR Code…": {
      "comment": "Button in Settings ▸ Server ▸ Pairing that opens the pairing QR code.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示二维码…"
          }
        }
      }
    },
    "Tabs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页"
          }
        }
      }
    },
    "Tailscale isn’t connected on this Mac. Connect it, then reopen this pane.": {
      "comment": "Footer under Settings ▸ Server ▸ Mobile when Tailscale is chosen but this Mac is not on a running tailnet.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的 Tailscale 未连接。连接后重新打开此面板。"
          }
        }
      }
    },
    "The tunnel address works from any network, and terminates on the provider's servers. Pick Custom to run your own relay instead.": {
      "comment": "Footer in Settings ▸ Server ▸ Pairing when a bundled third-party tunnel is selected. “Custom” names another entry in the same picker — translate it identically.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道地址可在任意网络使用，并终结于服务商的服务器。若要改用自己的中继，请选择“自定义”。"
          }
        }
      }
    },
    "Traffic crosses the relay you run yourself — no third party in the path.": {
      "comment": "Footer in Settings ▸ Server ▸ Pairing when the user runs their own relay.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流量经由你自己运行的中继，路径中没有第三方。"
          }
        }
      }
    },
    "Turn On": {
      "comment": "Button in the pairing QR sheet that turns on Allow Paired Devices.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "Turn on Allow Paired Devices to pair an iPhone.": {
      "comment": "Shown in the QR sheet when serving is off. “Allow Paired Devices” names the switch — translate it identically.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“允许已配对设备”后才能配对 iPhone。"
          }
        }
      }
    },
    "Vertical": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纵向"
          }
        }
      }
    },
    "\n…and %lld more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n…还有 %lld 个"
          }
        }
      }
    },
    " Cost is estimated at API rates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用按 API 价格估算。"
          }
        }
      }
    },
    "%1$@ changed on %2$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在 %2$@ 上已被修改"
          }
        }
      }
    },
    "%@ and %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@"
          }
        }
      }
    },
    "%@ answered as a different machine than %@. Its address is being served by something else.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回应的是另一台机器，不是 %2$@。这个地址正被别的东西占用。"
          }
        }
      }
    },
    "%@ answered, but not with a pairing invite. Its termiod is probably older than this app — deploy it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有响应，但返回的不是配对邀请。它的 termiod 可能比本应用旧——重新部署一次。"
          }
        }
      }
    },
    "%@ answered, but not with the handshake termiod sends.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有回应，但回的不是 termiod 的握手。"
          }
        }
      }
    },
    "%@ arrived on %@ since the last setup. Set up again to install Termio’s hooks there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次设置之后，%@ 才装到 %@ 上。再设置一次，把 Termio 的 hook 装进去。"
          }
        }
      }
    },
    "%@ didn’t come up — check the network and retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未能启动——请检查网络后重试"
          }
        }
      }
    },
    "%@ exited — shell": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出——已回到 shell"
          }
        }
      }
    },
    "%@ has nothing to pair against": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上没有可配对的目标"
          }
        }
      }
    },
    "%@ is a dark theme in the %@ slot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是深色主题，与“%@”插槽不匹配。"
          }
        }
      }
    },
    "%@ is a light theme in the %@ slot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是浅色主题，与“%@”插槽不匹配。"
          }
        }
      }
    },
    "%@ is not an address the iPhone could dial.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是 iPhone 能拨通的地址。"
          }
        }
      }
    },
    "%@ is published, but the connection an iPhone would make was refused.\n%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已发布，但 iPhone 会发起的那种连接被拒绝了。\n%2$@"
          }
        }
      }
    },
    "%@ is ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已就绪。"
          }
        }
      }
    },
    "%@ isn’t a UTF-8 text file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是 UTF-8 文本文件。"
          }
        }
      }
    },
    "%@ isn’t available on this device yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暂不支持这台设备。"
          }
        }
      }
    },
    "%@ isn’t available on this machine yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暂不支持这台设备。"
          }
        }
      }
    },
    "%@ isn’t installed on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未安装在 %2$@ 上"
          }
        }
      }
    },
    "%@ isn’t installed on %@, and Termio doesn’t ship a build of it. Install it there, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上没有安装 %1$@，Termio 也不提供它的构建版本。请先在那台机器上安装，然后重试。"
          }
        }
      }
    },
    "%@ isn’t on your PATH": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在 PATH 中"
          }
        }
      }
    },
    "%@ isn’t published yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未发布"
          }
        }
      }
    },
    "%@ keeps exiting — retrying every %llds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 反复退出——每 %2$lld 秒重试一次"
          }
        }
      }
    },
    "%@ never answered on its published address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 始终没有在它发布的地址上回应。"
          }
        }
      }
    },
    "%@ opened %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 创建于 %2$@"
          }
        }
      }
    },
    "%@ refused the handshake.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了握手。"
          }
        }
      }
    },
    "%@ reports an architecture we have no build for: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 报告的架构没有对应的构建版本：%2$@"
          }
        }
      }
    },
    "%@ started on %@ but never printed an address.\n%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已在 %2$@ 上启动，但始终没有打印地址。\n%3$@"
          }
        }
      }
    },
    "%@ stays published only until you log out of it. Termio couldn’t set it to keep services running after that.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
