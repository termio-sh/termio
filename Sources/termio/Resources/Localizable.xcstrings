    },
    "git couldn’t create a worktree for “%@”. Is it a git repository with at least one commit?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "git 无法为“%@”创建 worktree。请确认它是包含至少一个提交的 git 仓库。"
          }
        }
      }
    },
    "Couldn’t inspect worktree": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 worktree"
          }
        }
      }
    },
    "git couldn’t check “%@” for changes, so it was not removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "git 无法检查“%@”是否有更改，因此未将其移除。"
          }
        }
      }
    },
    "Worktree has changes": {
      "localizations": {
