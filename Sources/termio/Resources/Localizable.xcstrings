    "This Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机"
          }
        }
      }
    },
    "This folder has no git “origin” remote to clone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件夹没有 git “origin” 远程，无法克隆。"
