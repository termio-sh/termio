        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束"
          }
        }
      }
    },
    "New Session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建会话"
          }
        }
      }
    },
    "Opened outside Termio on this device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台设备上由 Termio 之外打开"
          }
