      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色主题"
          }
        }
      }
    },
    "Didn't catch that — try again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清，请再试一次"
          }
        }
      }
